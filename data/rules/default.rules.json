{
  "$comment": "도트 규칙 수치. 각 항목의 rule id는 코드 주석 // rule: <id> 와 렌더 로그에 사용. source는 연구 노트 근거.",
  "version": 1,
  "ramp": {
    "id": "color.ramp.hue-shift",
    "source": "Slynyrd Pixelblog 1 (HSB palettes)",
    "steps": 5,
    "deltaL": 0.11,
    "hueShift": 8,
    "warmHue": 70,
    "coolHue": 260,
    "chromaFalloff": 0.25,
    "minL": 0.18,
    "maxL": 0.93,
    "avoidHueBand": [115, 165],
    "avoidHueBandNote": "그림자·하이라이트가 초록으로 지나가면 탁해 보인다. 경로가 이 대역(OKLCh h)을 지나면 반대 방향으로 돈다",
    "reservedMinDistance": 0.03,
    "collisionNudgeL": 0.02,
    "collisionMaxNudges": 5,
    "outlineToneDeltaL": 0.08,
    "outlineToneChroma": 0.6
  },
  "materialContrast": {
    "id": "color.material-contrast",
    "source": "Gen Jam 2016 procedural sprites: metal ramps vary a lot, cloth little",
    "metal": 1.4,
    "cloth": 0.8,
    "skin": 0.9,
    "default": 1.0
  },
  "shade": {
    "id": "form.shade-quantize",
    "source": "directional light, avoid pillow shading",
    "thresholds": [0.15, 0.45, 0.75],
    "backLimbDarken": 1,
    "backLimbRuleId": "form.depth-cue"
  },
  "cleanup": {
    "id": "form.cleanup",
    "source": "pixel art fundamentals (orphans, jaggies)",
    "minCluster": 3,
    "removeOrphans": true,
    "pixelPerfectLines": true
  },
  "outline": {
    "id": "form.outline",
    "source": "Saint11 Outlines (selective outline)",
    "mode": "selout",
    "seloutLitThreshold": 0.35,
    "innerLines": true
  },
  "budgetFit": {
    "id": "color.budget-fit",
    "source": "고유 색 수가 예산을 넘으면 같은 재질에서 가장 적게 쓰인 단계를 가장 가까운 사용 중 단계로 병합. 작은 소품은 3단계(어둠·기본·하이라이트)로",
    "smallPartArea": 12
  },
  "face": {
    "id": "form.face",
    "source": "눈이 보여야 캐릭터가 읽힌다. 3/4 시점 먼 쪽 눈은 1px, 머리 외곽선에서 1px 띄움",
    "farEyeGap": 1
  },
  "heldThinShade": {
    "id": "form.held-thin-shade",
    "source": "사용자 승인(P5 확인): 두께 3px 이하 held 파츠는 명암 단계를 다 쓰면 어두운 줄이 게임 배경에 묻혀 1px로 보인다. 날·몸체는 램프의 가장 밝은 2단계만, 어두운 톤은 손잡이(부착점 쪽)·날끝 1px에만",
    "maxThickness": 3,
    "brightSteps": 2
  },
  "held": {
    "id": "form.held-min-width",
    "source": "사용자 승인(P4 보정): 손에 든 무기·소품은 1px 획이면 외곽선 톤에 묻혀 사라진다. held 파츠 두께 최소 2px, 1px은 decorative 파츠만",
    "minWidth": 2
  },
  "colorBudget": {
    "id": "color.budget",
    "source": "SNES 스프라이트 팔레트 15색+투명, 보스는 팔레트 2개. 프레임에 실제로 쓰인 고유 색 수(외곽선 톤·fx 포함)로 센다",
    "character": 15,
    "smallMonster": 7,
    "boss": 30
  },
  "anim": {
    "id": "anim.pose-to-pose",
    "source": "Dead Cells: interpolation frames only before or after keys, never in-between",
    "defaultKeyMs": 120,
    "strikeMaxMs": 80,
    "maxInbetweenPerKey": 2,
    "attackKeyCount": [4, 6],
    "inbetweenMs": 60
  },
  "qa": {
    "id": "qa.thresholds",
    "sheetScale": 4,
    "orphanMax": 2,
    "bandingMax": 3,
    "silhouetteIoUMax": 0.8,
    "contrastMinL": 0.18,
    "scaleTolerance": 0.15,
    "flickerMax": 0,
    "faceCoverMax": 0.15,
    "detailMinPx": 3,
    "detailMaxCount": 2,
    "roleColorMin": 0.2,
    "heldVisibleMin": 0.6
  }
}
